# Caddy: TLS автоматически (Let's Encrypt), проксирование приложения и Grafana.
#
# Домен и почта для ACME берутся из переменных окружения DOMAIN и ACME_EMAIL
# (заданы сервису caddy в docker-compose.yml).

{
	email {$ACME_EMAIL}
}

# www → без www
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Долгий кэш неизменяемой статики Next и наших медиафайлов
	@nextstatic path /_next/static/*
	header @nextstatic Cache-Control "public, max-age=31536000, immutable"
	@media path /courses/* /brand/* /uploads/*
	header @media Cache-Control "public, max-age=604800"

	# Grafana доступна по адресу https://{$DOMAIN}/grafana/
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# Приложение (включая Server-Sent Events — поток живых событий)
	handle {
		reverse_proxy app:4321 {
			# Немедленная отдача чанков: без этого SSE буферизуется
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# --- GlitchTip (трекер ошибок) ----------------------------------------------
# Опционально. Если поднимаете GlitchTip (deploy/glitchtip), задайте ERRORS_DOMAIN
# в .env и раскомментируйте блок ниже. Пока ERRORS_DOMAIN пуст, блок должен быть
# закомментирован — иначе Caddy получит сайт без адреса и не запустится.
# {$ERRORS_DOMAIN} {
# 	reverse_proxy glitchtip:8000
# }
