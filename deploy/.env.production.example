# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Файл .env не попадает в git.

# Домен и TLS
DOMAIN=mashuk.online
ACME_EMAIL=admin@czmashuk.ru

# PostgreSQL (внутренний, в compose)
POSTGRES_USER=mashuk
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ
POSTGRES_DB=mashuk_platform

# Grafana (доступна на https://DOMAIN/grafana/)
GF_SECURITY_ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_ПАРОЛЬ

# Образ приложения в реестре (заполняет CD при деплое)
APP_IMAGE=ghcr.io/zuevpu/mashukonline:latest

# Приём ошибок. Заполните, когда подключите Sentry SDK к приложению
# и поднимете GlitchTip (deploy/glitchtip). Иначе оставьте пустым.
SENTRY_DSN=

# Хранилище файлов S3 (необязательно): фото из чатов и сборки программ.
# Пусто — файлы лежат в томе storage на сервере. Подходит любое S3-совместимое
# хранилище, адресация path-style. Пример для Yandex Object Storage:
#   S3_ENDPOINT=https://storage.yandexcloud.net  S3_REGION=ru-central1
# Бакет — приватный: файлы отдаёт приложение и только участникам.
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Для GlitchTip (если используете deploy/glitchtip)
ERRORS_DOMAIN=errors.example.ru
GLITCHTIP_SECRET_KEY=ЗАМЕНИТЕ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ

# Размер пула соединений с базой (по умолчанию 20). Держите ниже max_connections
# Postgres (по умолчанию 100) с запасом на миграции и бэкапы.
# DB_POOL_MAX=20

# Секрет для обезличенных ключей ответов в опросах (не даёт ответить дважды
# и не раскрывает автора анонимного ответа). Сгенерируйте один раз:
#   openssl rand -base64 32
# и больше не меняйте — иначе повторный ответ в уже идущем опросе станет возможен.
AUTH_SECRET=

# Единый вход с LMS (OAuth 2.0). Пока не заданы authorize-url и client-id,
# кнопка входа через LMS скрыта. redirect_uri: <PUBLIC_URL>/api/auth/sso/lms/callback
LMS_OAUTH_AUTHORIZE_URL=
LMS_OAUTH_TOKEN_URL=
LMS_OAUTH_USERINFO_URL=
LMS_OAUTH_CLIENT_ID=
LMS_OAUTH_CLIENT_SECRET=
LMS_OAUTH_SCOPE=
PUBLIC_URL=https://mashuk.online
